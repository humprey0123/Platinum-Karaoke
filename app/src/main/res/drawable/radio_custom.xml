<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <!-- Radio -->
            <item
                android:width="15dp"
                android:height="15dp"
                android:gravity="center">

                <shape android:shape="oval">
                    <solid android:color="#E2AE24" />
                </shape>

            </item>

        </layer-list>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <!-- Radio -->
            <item
                android:width="15dp"
                android:height="15dp"
                android:gravity="center">

                <shape android:shape="oval">
                    <solid android:color="#ffffff" />
                </shape>

            </item>

        </layer-list>
    </item>

    <item>
        <layer-list>
            <!-- Radio -->
            <item
                android:width="15dp"
                android:height="15dp"
                android:gravity="center">

                <shape android:shape="oval">
                    <solid android:color="#33FFFFFF" />
                </shape>

            </item>

        </layer-list>
    </item>

</selector>