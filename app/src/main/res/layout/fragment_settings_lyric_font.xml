<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/fragment_settings_lyric_font"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginHorizontal="30dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/lyric_font_default"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="18sp"
            style="@style/SoundSettings"
            android:text="Default"/>
        <TextView
            android:id="@+id/lyric_font_random_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="18sp"
            style="@style/SoundSettings"
            android:text="Random All"/>
        <TextView
            android:id="@+id/lyric_font_select_one"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="18sp"
            style="@style/SoundSettings"
            android:text="Select One"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8">
        <RadioGroup
            android:id="@+id/lyric_font_group1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingLeft="20dp"
            android:paddingVertical="20dp"
            android:layout_height="match_parent">
            <RadioButton
                android:id="@+id/lyric_font_agenta_chubby_demo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/selector_radio_color"
                android:text="Agenta Chubby Demo"/>
            <RadioButton
                android:id="@+id/lyric_font_albha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/selector_radio_color"
                android:text="Albha"/>
            <RadioButton
                android:id="@+id/lyric_font_black_ops_one_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/selector_radio_color"
                android:text="Black Ops One Regular"/>
            <RadioButton
                android:id="@+id/lyric_font_machiato_show"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/selector_radio_color"
                android:text="Machiato Show"/>
            <RadioButton
                android:id="@+id/lyric_font_merienda_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/selector_radio_color"
                android:text="Merienda Regular"/>

        </RadioGroup>
        <RadioGroup
            android:id="@+id/lyric_font_group2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingLeft="20dp"
            android:paddingVertical="20dp"
            android:layout_height="match_parent">
            <RadioButton
                android:id="@+id/lyric_font_merriweather_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/selector_radio_color"
                android:text="Merriweather Bold"/>
            <RadioButton
                android:id="@+id/lyric_font_monoline_script_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/selector_radio_color"
                android:text="Monoline Script Regular"/>
            <RadioButton
                android:id="@+id/lyric_font_sweet_candy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/selector_radio_color"
                android:text="Sweet Candy"/>
            <RadioButton
                android:id="@+id/lyric_font_ubuntu_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/selector_radio_color"
                android:text="Ubuntu Bold"/>
            <RadioButton
                android:id="@+id/lyric_font_roboto_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/selector_radio_color"
                android:text="Roboto Medium"/>
        </RadioGroup>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical">
        <TextView
            android:id="@+id/lyric_font_selected"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:textSize="18sp"
            style="@style/SoundSettings"
            android:text="Select One"/>

        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SoundSettings">

            <com.example.platinumkaraoke.StrokeTextView
                android:id="@+id/lyric_font_sample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:layout_marginHorizontal="2dp"
                android:textSize="29sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textColor="#73AAD0"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="4"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="We live to share moments"
                tools:ignore="UnusedAttribute" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>