<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchFragment"
    android:layout_marginTop="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Navbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="30dp"
            android:gravity="center_vertical">

            <!-- LEFT: Default Categories -->
            <LinearLayout
                android:id="@+id/active_category_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <!-- RIGHT: Search Bar -->
            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_radius"
                android:focusable="false"
                android:clickable="false"
                android:focusableInTouchMode="false"
                android:hint="@string/search_hint"
                android:inputType="none"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#BDFFFFFF"
                android:textSize="14sp"
                android:imeOptions="flagNoExtractUi"
                />
        </LinearLayout>

        <!-- Second Navbar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="100dp"
            android:layout_marginEnd="40dp"
            android:scrollbars="none"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="40dp"
            android:requiresFadingEdge="horizontal"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/choice_category_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>

        </HorizontalScrollView>

        <!-- Mid-Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingEnd="30dp"
            android:paddingStart="40dp"
            android:layout_marginTop="5dp"

            android:layout_weight="1">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:paddingEnd="20dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.example.platinumkaraoke.TvRecyclerView
                    android:id="@+id/songRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:descendantFocusability="afterDescendants"/>

                <!-- Scrollbar track -->
                <View
                    android:id="@+id/scrollTrack"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:layout_marginEnd="2dp"
                    android:background="#99FFFFFF"/>

                <!-- Scrollbar thumb -->
                <View
                    android:id="@+id/scrollThumb"
                    android:layout_width="6dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/scroll_thumb"/>

            </FrameLayout>
            <!-- Keyboard -->
            <include layout="@layout/keyboard"/>
        </LinearLayout>

        <!-- Stays at the bottom always-->
        <include layout="@layout/component_footer"/>

    </LinearLayout>


</FrameLayout>

