<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/slider_container"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_popup"
    android:padding="12dp">


<!-- TODO: add id-->
    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginBottom="8dp"
        android:padding="5dp"
        android:src="@drawable/gear1"
        android:background="@drawable/selector_button"
        android:tint="@color/selector_icon_tint"
        android:focusable="true"
        android:contentDescription="@string/btn_settings"
        android:id="@+id/btn_settings"/>

    <LinearLayout
        android:id="@+id/popup_settings_seeker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <LinearLayout
        android:id="@+id/bgv_row_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:paddingVertical="5dp"
        android:layout_margin="2dp"
        android:background="@drawable/selector_bg_transparent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:textColor="#fff"
            android:textSize="12sp"
            android:text="BGV"/>

        <RadioGroup
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4">

                <!-- Auto -->
                <LinearLayout
                    android:id="@+id/bgv_auto_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/bgv_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/selector_radio_color"
                        android:text=""/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto"
                        android:textColor="#fff"
                        android:textSize="10sp"/>
                </LinearLayout>

                <!-- 3D -->
                <LinearLayout
                    android:id="@+id/bgv_3d_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/bgv_3d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/selector_radio_color"
                        android:text=""/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#fff"
                        android:text="3D"
                        android:textSize="10sp"/>
                </LinearLayout>

                <!-- View -->
                <LinearLayout
                    android:id="@+id/bgv_view_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/bgv_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/selector_radio_color"
                        android:text=""/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#fff"
                        android:text="View"
                        android:textSize="10sp"/>
                </LinearLayout>

                <!-- Event -->
                <LinearLayout
                    android:id="@+id/bgv_event_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/bgv_event"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/selector_radio_color"
                        android:text=""/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#fff"
                        android:text="Event"
                        android:textSize="10sp"/>
                </LinearLayout>

                <!-- Abstract -->
                <LinearLayout
                    android:id="@+id/bgv_abstract_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/bgv_abstract"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/selector_radio_color"
                        android:text=""/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#fff"
                        android:text="Abstract"
                        android:textSize="10sp"/>
                </LinearLayout>

                <!-- MV -->
                <LinearLayout
                    android:id="@+id/bgv_mv_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/bgv_mv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/selector_radio_color"
                        android:text=""/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#fff"
                        android:text="MV"
                        android:textSize="10sp"/>
                </LinearLayout>

                <!-- Sexy -->
                <LinearLayout
                    android:id="@+id/bgv_sexy_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/bgv_sexy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/selector_radio_color"
                        android:text=""/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#fff"
                        android:text="Sexy"
                        android:textSize="10sp"/>
                </LinearLayout>

                <!-- User -->
                <LinearLayout
                    android:id="@+id/bgv_user_container"                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/bgv_user"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/selector_radio_color"
                        android:text=""/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#fff"
                        android:text="User"
                        android:textSize="10sp"/>
                </LinearLayout>

            </GridLayout>

        </RadioGroup>
    </LinearLayout>


</LinearLayout>