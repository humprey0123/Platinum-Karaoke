                android:layout_weight="4"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="Intro Sound:"/>
            <TextView
                style="@style/SoundSettings"
                android:text="Off"/>

            <TextView
                style="@style/SoundSettings"
                android:text="Low"/>
            <TextView
                style="@style/SoundSettings"
                android:text="Middle"/>
            <TextView
                style="@style/SoundSettings"
                android:text="High"/>

