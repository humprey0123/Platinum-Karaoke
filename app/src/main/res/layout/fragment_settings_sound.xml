            <TextView
                style="@style/SoundSettings"
                android:text="Off"/>

            <TextView
                style="@style/SoundSettings"
                android:text="Low"/>
            <TextView
                style="@style/SoundSettings"
                android:text="Middle"/>
            <TextView
                style="@style/SoundSettings"
                android:text="High"/>

