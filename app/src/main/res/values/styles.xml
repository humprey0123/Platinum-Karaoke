<resources>

    <!-- Your existing themes/styles -->

    <style name="NavItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginHorizontal">8dp</item>
    </style>

    <style name="CategoryTabs">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginHorizontal">8dp</item>
    </style>

    <style name="ChoiceCategory">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">5dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:textColor">@color/focus_text_color</item>
    </style>


    <style name="SongInfo">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:textSize">18sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:singleLine">true</item>
        <item name="android:state_selected">true</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>"

        <item name="android:textAlignment">viewStart</item>

        <item name="android:duplicateParentState">true</item>
        <item name="android:textColor">@color/focus_text_color</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>