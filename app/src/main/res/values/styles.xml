<resources>

    <!-- Your existing themes/styles -->

    <style name="NavItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginHorizontal">8dp</item>
    </style>

    <style name="CategoryTabs">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginHorizontal">8dp</item>
    </style>

    <style name="ChoiceCategory">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">5dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:textColor">@color/focus_text_color</item>
    </style>


    <style name="SongInfo">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:textSize">18sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:singleLine">true</item>
        <item name="android:state_selected">true</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>"

        <item name="android:textAlignment">viewStart</item>

        <item name="android:duplicateParentState">true</item>
        <item name="android:textColor">@color/focus_text_color</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KeyboardRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Key">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/selector_key</item>
        <item name="android:textColor">#FFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="KeyWide">
        <item name="android:layout_width">111dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/selector_key</item>
        <item name="android:textColor">#FFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="GridItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>

        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">12dp</item>

        <!-- Makes it behave like a selectable button -->
        <item name="android:background">@drawable/selector_grid_item</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="SettingNav">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:textColor">@drawable/selector_settings_nav_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:background">@drawable/selector_settings_nav</item>
    </style>

    <style name="SettingEqualizer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:textColor">@drawable/selector_nav_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:background">@drawable/selector_settings_equalizer</item>
    </style>

    <style name="SoundSettings">
        <item name="android:textStyle">bold</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:focusable">True</item>
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">25dp</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@drawable/selector_nav_text</item>
        <item name="android:background">@drawable/selector_settings_button</item>
    </style>

</resources>